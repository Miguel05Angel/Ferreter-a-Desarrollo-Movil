# Copia este archivo como android/secrets.properties y pon la clave real.
# secrets.properties esta en el .gitignore: no se sube nunca.
#
# La clave sale de Google Cloud Console > APIs y servicios > Credenciales.
# Debe estar restringida a "Apps de Android" con el nombre de paquete y el
# SHA-1 de cada maquina del equipo. Ver docs/CLAVES.md.
MAPS_API_KEY=TU_CLAVE_AQUI
