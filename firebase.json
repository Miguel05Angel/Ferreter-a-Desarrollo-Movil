{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "ferreteria-el-constructor",
          "appId": "1:216446212508:android:71d539cc5108e292cbd059",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "ferreteria-el-constructor",
          "configurations": {
            "android": "1:216446212508:android:71d539cc5108e292cbd059",
            "web": "1:216446212508:web:de19719c6791698dcbd059"
          }
        }
      }
    }
  },
  "functions": {
    "source": "functions",
    "codebase": "default",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "headers": [
      {
        "source": "/",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      },
      {
        "source": "**/*.html",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      },
      {
        "source": "/@(flutter_bootstrap.js|main.dart.js|flutter_service_worker.js)",
        "headers": [{"key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate"}]
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
